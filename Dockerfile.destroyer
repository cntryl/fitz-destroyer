FROM node:24-alpine AS build

WORKDIR /destroyer

COPY package.json package-lock.json* ./
RUN npm ci

COPY tsconfig.json tsconfig.build.json ./
COPY src/ ./src/
RUN npm run build \
  && npm prune --omit=dev

FROM gcr.io/distroless/nodejs24-debian13:nonroot

WORKDIR /destroyer

COPY --from=build --chown=65532:65532 /destroyer/package.json ./package.json
COPY --from=build --chown=65532:65532 /destroyer/node_modules/ ./node_modules/
COPY --from=build --chown=65532:65532 /destroyer/dist/ ./dist/
COPY --chown=65532:65532 storage-proxy.mjs ./storage-proxy.mjs

CMD ["dist/worker.js"]
